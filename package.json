{
  "name": "claudedeck",
  "version": "0.2.0",
  "description": "ClaudeDeck — 把 Claude Code 封装成图形界面聊天软件的 Windows 桌面应用",
  "author": "Tenk",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "electron-vite build && node scripts/e2e.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always",
    "unit": "node scripts/unit.mjs",
    "measure": "electron-vite build && node scripts/measure.mjs",
    "contrast": "node scripts/contrast.mjs",
    "packaged": "node scripts/packaged.mjs",
    "icon": "node scripts/make-icon.mjs",
    "shots": "node scripts/shots-for-readme.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
